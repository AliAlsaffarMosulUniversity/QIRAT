rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email == 'ali_alsaffar@uomosul.edu.iq';
    }
    function validAnnouncement(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','name','gender','city','area','mosque','datetime','map','notes','status','ownerUid','createdAt','updatedAt'])
        && d.keys().hasOnly(['id','name','gender','city','area','mosque','datetime','map','notes','status','ownerUid','createdAt','updatedAt','cemetery'])
        && id.matches('[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}')
        && d.id == id
        && d.ownerUid == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.gender in ['male','female']
        && d.city is string && d.city.size() > 0 && d.city.size() <= 80
        && d.area is string && d.area.size() <= 100
        && d.mosque is string && d.mosque.size() > 0 && d.mosque.size() <= 120
        && d.datetime is string && d.datetime.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}')
        && d.map is string && d.map.size() <= 2000 && (d.map == '' || d.map.matches('https://.*'))
        && d.notes is string && d.notes.size() <= 600
        && (!('cemetery' in d) || (d.cemetery is string && d.cemetery.size() <= 120))
        && d.status == 'published'
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /announcements/{id} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 500;
      allow create: if signedIn() && validAnnouncement(id) && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && validAnnouncement(id) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }
  }
}

